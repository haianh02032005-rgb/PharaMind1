APP_NAME=PharmaMind AI
APP_VERSION=0.1.0
DEBUG=true
CORS_ORIGINS=["http://localhost:5173"]

DATABASE_URL=postgresql+psycopg://pharmamind:pharmamind_dev@localhost:5432/pharmamind
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
DEMO_RESET_ON_LOGIN=true

REDIS_URL=
MQTT_URL=
OPENAI_API_KEY=

# Prescription uploads. Use a mounted persistent volume for local storage,
# or set FILE_STORAGE_BACKEND=s3 for a private S3-compatible bucket.
FILE_STORAGE_BACKEND=local
FILE_STORAGE_LOCAL_PATH=storage/imports
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=prescription-imports

# Local OCR for real images and scanned PDFs (Tesseract 5 + Vietnamese data).
OCR_ENABLED=true
OCR_LANGUAGES=vie+eng
OCR_TIMEOUT_SECONDS=45
OCR_PDF_MAX_PAGES=10
OCR_RENDER_DPI=300
OCR_MAX_IMAGE_PIXELS=30000000
OCR_TESSERACT_CMD=
OCR_TESSDATA_DIR=
OCR_POPPLER_PATH=
