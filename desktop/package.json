{
  "name": "pharmamind-ai-desktop",
  "version": "1.2.0",
  "description": "PharmaMind AI desktop application for Windows and Linux",
  "desktopName": "pharmamind-ai.desktop",
  "main": "main.cjs",
  "private": true,
  "author": {
    "name": "PharmaMind AI",
    "email": "haianh02032005-rgb@users.noreply.github.com"
  },
  "homepage": "https://pharmamind-ai-demo.onrender.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haianh02032005-rgb/PharaMind1.git"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:linux": "npm run dist:linux:x64",
    "dist:linux:x64": "electron-builder --linux AppImage deb --x64 --publish never",
    "dist:linux:arm64": "electron-builder --linux AppImage deb --arm64 --publish never",
    "prepare:pi": "node scripts/prepare-pi.cjs"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "ai.pharmamind.desktop",
    "productName": "PharmaMind AI",
    "copyright": "Copyright © 2026 PharmaMind AI",
    "asar": true,
    "files": [
      "main.cjs",
      "preload.cjs",
      "local-web.cjs",
      "web/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "PharmaMind-AI-Desktop-Setup-${version}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage"
        },
        {
          "target": "deb"
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "executableName": "pharmamind-ai",
      "syncDesktopName": true,
      "artifactName": "PharmaMind-AI-Desktop-${version}-linux-${arch}.${ext}",
      "maintainer": "PharmaMind AI <haianh02032005-rgb@users.noreply.github.com>"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PharmaMind AI",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
